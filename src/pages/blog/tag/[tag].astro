---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import {
  published,
  sortByDate,
  tagSlug,
  postsForTag,
  allTags,
} from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = published(await getCollection("posts"));
  const tags = allTags(posts).map(tagSlug);
  return [...new Set(tags)].map((slug) => ({
    params: { tag: slug },
    props: { posts, slug },
  }));
}

const { posts, slug } = Astro.props;
const tag = [...new Set(posts.flatMap((p) => p.data.tags))].find(
  (t) => tagSlug(t) === slug
);
const matched = sortByDate(postsForTag(posts, tag ?? slug));
const tags = allTags(posts);
const display = tag ?? slug.replace(/-/g, " ");
---

<BaseLayout
  title={`Notes tagged “${display}”`}
  description="Field notes on AI engineering — agents, RAG, local-first systems, tool calling, evaluation, and the occasional rant."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="kicker" data-reveal>notes / tag</p>
      <h1 data-reveal>
        <span class="mark">{display}.</span>
      </h1>
      <p class="lede" data-reveal>
        {matched.length} note{matched.length === 1 ? "" : "s"} under this tag —
        a slice of the field notebook kept for the subject, not the season.
        <span class="annote">— tags row below, newest first</span>
      </p>
      <div class="statline" data-reveal>
        <span><b>{matched.length}</b> notes</span>
        <span><b>{tags.length}</b> tags total</span>
        <span><a href="/blog" style="color:var(--accent-text);text-decoration:none">the whole notebook ↗</a></span>
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:0">
    <div class="container">
      <div class="tag-row" data-reveal style="margin-bottom:1.6rem">
        {tags.map((t) => {
          const s = tagSlug(t);
          return (
            <a
              class="pill"
              href={`/blog/tag/${s}/`}
              aria-current={s === slug ? "true" : undefined}
              style="text-decoration:none"
            >{t}</a>
          );
        })}
      </div>

      <div style="margin-top:1rem">
        {matched.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            href={`/blog/${post.id}/`}
            minutes={post.data.readingMinutes ?? 5}
          />
        ))}
      </div>

      {matched.length === 0 && (
        <p class="muted">
          No notes under that tag yet — the nearest thing is the{" "}
          <a href="/blog" style="color:var(--accent)">whole notebook</a>.
        </p>
      )}

      <div class="card cta-box" data-reveal style="margin-top:2.8rem">
        <span class="cb-k">the bench, on hire</span>
        <h3>Collecting on a subject? So am I.</h3>
        <p>
          If this tag is your problem too, it's also my backlog — the field
          notebook and the client work come from the same bench.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/hire">Work with me <span class="arr">↗</span></a>
          <a class="btn btn-ghost" href="/links">The link shelf</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>