---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { sortByDate, onPersonalSite, allTags, tagSlug } from "../lib/posts";

const all = sortByDate(onPersonalSite(await getCollection("posts")));
const tags = allTags(all);
---

<BaseLayout
  title="Notes"
  description="Field notes on AI engineering — agents, RAG, local-first systems, tool calling, evaluation, and the occasional rant."
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="kicker" data-reveal>notes</p>
      <h1 data-reveal>The <span class="mark">field notebook.</span></h1>
      <p class="lede" data-reveal>
        {all.length} notes, written to be useful next quarter, not just this week.
        Practical AI engineering — agents, context, RAG, local-first systems.
        <span class="annote">— sorted newest first, opinions included</span>
      </p>
      <div class="statline" data-reveal>
        <span><b>{all.length}</b> notes</span>
        <span><b>{tags.length}</b> tags</span>
        <span><a href="/blog/rss.xml" style="color:var(--accent-text);text-decoration:none">rss ↗</a></span>
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:0">
    <div class="container">
      <div class="tag-row" data-reveal style="margin-bottom:1.6rem">
        <a class="pill" href="/blog" aria-current="true" style="text-decoration:none">all</a>
        {tags.map((t) => (
          <a class="pill" href={`/blog/tag/${tagSlug(t)}/`} style="text-decoration:none">{t}</a>
        ))}
      </div>

      <div style="margin-top:1rem">
        {all.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            href={`/blog/${post.id}/`}
            minutes={post.data.readingMinutes ?? 5}
          />
        ))}
      </div>

      <div class="card cta-box" data-reveal style="margin-top:2.8rem">
        <span class="cb-k">the bench, on hire</span>
        <h3>Reading beats talking. Building beats both.</h3>
        <p>
          If any of the notes look like your problem, they're also my backlog — the
          field notebook and the client work come from the same bench.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/hire">Work with me <span class="arr">↗</span></a>
          <a class="btn btn-ghost" href="/links">The link shelf</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>